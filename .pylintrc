[MASTER]
jobs=1
ignore=CVS,.git,__pycache__,build,dist,.venv,venv
persistent=no
load-plugins=pylint_hyperparallel

[MAIN]
py-version=3.9
init-hook=import sys; from pathlib import Path; repo_root = Path.cwd().resolve(); repo_root_str = str(repo_root); scripts_str = str(repo_root / 'scripts'); sys.path.insert(0, repo_root_str) if repo_root_str not in sys.path else None; sys.path.insert(0, scripts_str) if scripts_str not in sys.path else None

[MESSAGES CONTROL]
disable=
    C0103,
    C0114,
    C0115,
    C0116,
    C0209,
    C0302,
    C0325,
    E0401,
    E0611,
    R0801,
    R0901,
    R0902,
    R0903,
    R0904,
    R0911,
    R0912,
    R0913,
    R0914,
    R0915,
    R0916,
    R0917,
    R1702,
    W0201,
    W0212,
    W0221,
    W0223,
    W0231,
    W0237,
    W0511,
    W0612,
    W0622,
    W0640,
    W0718,
    W1203
enable=
    W1510,
    W1514,
    W1515,
    R1732

[REPORTS]
score=no
msg-template={path}:{line}:{column}: [{msg_id}({symbol}), {obj}] {msg}

[FORMAT]
max-line-length=120
max-module-lines=1200

[BASIC]
good-names=i,j,k,ex,fp,fn,_
bad-names=l,I,o,O0
class-rgx=[A-Z_][a-zA-Z0-9]+$
function-rgx=([a-z_][a-z0-9_]*)|(__[a-z0-9_]+__)$
method-rgx=([a-z_][a-z0-9_]*)|(__[a-z0-9_]+__)$
attr-rgx=[a-z_][a-z0-9_]*$
argument-rgx=[a-z_][a-z0-9_]*$
variable-rgx=[a-z_][a-z0-9_]*$
const-rgx=([A-Z_][A-Z0-9_]*)|(__[a-z0-9_]+__)$
inlinevar-rgx=[a-z_][a-z0-9_]*$

[TYPECHECK]
generated-members=numpy.*,torch.*,mindspore.*

[DESIGN]
max-args=8
max-locals=15
max-returns=6
max-branches=15
max-statements=60
max-attributes=12
min-public-methods=0
max-bool-expr=5

[EXCEPTIONS]
overgeneral-exceptions=builtins.Exception
