+class _OverlapTinyNet(torch.nn.Module):
+    """Small module used to validate wrapper overlap detection at construction time."""
+
+    def __init__(self):
+        super().__init__()
+        self.fc1 = torch.nn.Linear(4, 4)
+        self.fc2 = torch.nn.Linear(4, 4)
+
+        def local_activation(x):
+            return torch.relu(x)
+
+        self.local_activation = local_activation
+        self.framework_activation = F.gelu
+
+    def scale(self, x):
+        return x * 2
+
+    def forward(self, x):
+        x = self.fc1(x)
+        x = self.local_activation(x)
+        x = self.framework_activation(x)
+        return self.fc2(x)
+    
+
+def _overlap_same_module_twice():
+    net = _OverlapTinyNet()
+    checkpoint_wrapper(net.fc1)
+    checkpoint_wrapper(net.fc1)
+
+
+def _overlap_checkpoint_then_swap_same_module():
+    net = _OverlapTinyNet()
+    checkpoint_wrapper(net.fc1)
+    swap_wrapper(net.fc1)
+
+
+def _overlap_child_then_parent():
+    net = _OverlapTinyNet()
+    net.fc1 = checkpoint_wrapper(net.fc1)
+    checkpoint_wrapper(net)
+
+
+def _overlap_parent_then_child():
+    net = _OverlapTinyNet()
+    wrapped = checkpoint_wrapper(net)
+    checkpoint_wrapper(wrapped.fc1)
+
+
+def _overlap_callable_attr_then_parent():
+    net = _OverlapTinyNet()
+    net.local_activation = checkpoint_wrapper(net.local_activation)
+    checkpoint_wrapper(net)
+
+
+def _overlap_parent_then_callable_attr():
+    net = _OverlapTinyNet()
+    wrapped = checkpoint_wrapper(net)
+    checkpoint_wrapper(wrapped.local_activation)
+
+
+@pytest.mark.parametrize(
+    "case",
+    [
+        _overlap_same_module_twice,
+        _overlap_checkpoint_then_swap_same_module,
+        _overlap_child_then_parent,
+        _overlap_parent_then_child,
+        _overlap_callable_attr_then_parent,
+        _overlap_parent_then_callable_attr,
+    ],
+)
+def test_wrapper_overlap_detection_cases(case):
+    """Overlapping wrapper regions should be rejected consistently."""
+    with pytest.raises(ValueError, match="Wrapping overlapping module regions is not allowed"):
+        case()
+
+
+def _allowed_distinct_sibling_modules():
+    net = _OverlapTinyNet()
+    net.fc1 = checkpoint_wrapper(net.fc1)
+    net.fc2 = swap_wrapper(net.fc2)
+
+
+def _allowed_framework_function_reuse():
+    checkpoint_wrapper(F.gelu)
+    swap_wrapper(F.gelu)
+
+
+def _allowed_framework_function_attr_after_parent_wrap():
+    net = _OverlapTinyNet()
+    wrapped = checkpoint_wrapper(net)
+    checkpoint_wrapper(wrapped.framework_activation)
+
+
+def _allowed_bound_method_reuse():
+    net = _OverlapTinyNet()
+    checkpoint_wrapper(net.scale)
+    swap_wrapper(net.scale)
+
+
+@pytest.mark.parametrize(
+    "case",
+    [
+        _allowed_distinct_sibling_modules,
+        _allowed_framework_function_reuse,
+        _allowed_framework_function_attr_after_parent_wrap,
+        _allowed_bound_method_reuse,
+    ],
+)
+def test_wrapper_non_overlapping_allowed_cases(case):
+    """Non-overlapping or explicitly exempt callable configurations should be allowed."""
+    case()
