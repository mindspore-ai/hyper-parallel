+template <typename TYPE_X, typename T, bool DETERMINISTIC>
+__aicore__ inline void MhcPreGradKernel<TYPE_X, T, DETERMINISTIC>::ProcessGradPrepareTask(
+    const int64_t taskOffset, const int32_t tileTaskCount)
+{
+    if ASCEND_IS_AIV {
+        GetHcScaleAndHcBase();
+        for (int64_t tileOffset = 0; tileOffset < tileTaskCount; tileOffset += tileCoreBS_) {
+            int32_t nativeCount =
+                min(static_cast<int32_t>(tileCoreBS_), static_cast<int32_t>(tileTaskCount - tileOffset));
+            tileRepeatTimes_ = Ops::Base::CeilDiv(static_cast<int64_t>(nativeCount) * 2 * n_,
+                                                  static_cast<int64_t>(ELEMENTS_SIZE_PER_REPEAT));
+            Duplicate(dPrePostTempLocal_, 0.f, tileCoreBS_ * n_ * 2);
+            for (int64_t innerOffset = 0; innerOffset < nativeCount; innerOffset += onceTask_) {
+                int32_t innerCount =
+                    min(static_cast<int32_t>(onceTask_), static_cast<int32_t>(nativeCount - innerOffset));
+                ComputeGradPre(taskOffset + tileOffset + innerOffset, innerCount, innerOffset);
+            }
+            StorePreviousPreAndLoadCurrentPre(taskOffset + tileOffset, nativeCount);
+            ComputeGradHHat2(taskOffset + tileOffset, nativeCount);
+            SetFlag<HardEvent::V_MTE3>(eventIdVToMTE3XCast);
+            WaitFlag<HardEvent::V_MTE3>(eventIdVToMTE3XCast);
+            DataCopyPad(
+                gradRsqrtWorkspaceGlobal_[taskOffset + tileOffset], gradRsqrtLocal_,
+                {static_cast<uint16_t>(1), static_cast<uint32_t>(nativeCount * sizeof(T)), 0, 0, 0});
+        }
+        tileRepeatTimes_ = Ops::Base::CeilDiv(tileCoreBS_ * 2 * n_,
+                                              static_cast<int64_t>(ELEMENTS_SIZE_PER_REPEAT));
+        ComputeScaleBias();
+        GetTPipePtr()->ReleaseEventID<HardEvent::V_MTE3>(eventIdVToMTE3XCast);
+    }
+}
+
+template <typename TYPE_X, typename T, bool DETERMINISTIC>
+__aicore__ inline void MhcPreGradKernel<TYPE_X, T, DETERMINISTIC>::ProcessPhiRmsTask(
+    const int64_t taskOffset, const int32_t tileTaskCount)
+{
+    if ASCEND_IS_AIC {
+        const int32_t nativeCubeTile = 2 * tileCoreBS_;
+        for (int64_t tileOffset = 0; tileOffset < tileTaskCount; tileOffset += nativeCubeTile) {
+            int32_t nativeCount =
+                min(nativeCubeTile, static_cast<int32_t>(tileTaskCount - tileOffset));
+            ProcessMatmul1(taskOffset + tileOffset, nativeCount);
+            ProcessMatmul2(taskOffset + tileOffset, nativeCount);
+        }
+    }
+}
+
+template <typename TYPE_X, typename T, bool DETERMINISTIC>
+__aicore__ inline void MhcPreGradKernel<TYPE_X, T, DETERMINISTIC>::ProcessGradPreviousXTask(
+    const int64_t taskOffset, const int32_t tileTaskCount)
+{
+    if ASCEND_IS_AIV {
+        for (int64_t tileOffset = 0; tileOffset < tileTaskCount; tileOffset += tileCoreBS_) {
+            int32_t nativeCount =
+                min(static_cast<int32_t>(tileCoreBS_), static_cast<int32_t>(tileTaskCount - tileOffset));
+            int32_t brcbAlign = static_cast<int32_t>(Ops::Base::CeilDiv(
+                static_cast<int64_t>(nativeCount) * n_, static_cast<int64_t>(ELEMENTS_SIZE_PER_BLOCK)));
+            auto preLocal = inputGradQueue.AllocTensor<T>();
+            DataCopyPad(
+                preLocal, preGlobal_[(taskOffset + tileOffset) * n_],
+                {static_cast<uint16_t>(1), static_cast<uint32_t>(nativeCount * n_ * sizeof(T)), 0, 0, 0},
+                {false, 0, 0, 0});
+            inputGradQueue.EnQue(preLocal);
+            inputGradQueue.DeQue();
+            Brcb(preBrcbLocal_, preLocal, brcbAlign, {static_cast<uint8_t>(1), static_cast<uint8_t>(8)});
+            inputGradQueue.FreeTensor(preLocal);
+
+            DataCopyPad(
+                gradRsqrtLocal_, gradRsqrtWorkspaceGlobal_[taskOffset + tileOffset],
+                {static_cast<uint16_t>(1), static_cast<uint32_t>(nativeCount * sizeof(T)), 0, 0, 0},
+                {false, 0, 0, 0});
+            event_t eventMte2V = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
+            SetFlag<HardEvent::MTE2_V>(eventMte2V);
+            WaitFlag<HardEvent::MTE2_V>(eventMte2V);
+            brcbAlign = static_cast<int32_t>(Ops::Base::CeilDiv(
+                static_cast<int64_t>(nativeCount), static_cast<int64_t>(ELEMENTS_SIZE_PER_BLOCK)));
+            Brcb(dRsqrtBrcbLocal_, gradRsqrtLocal_, brcbAlign,
+                 {static_cast<uint8_t>(1), static_cast<uint8_t>(8)});
+
+            for (int64_t innerOffset = 0; innerOffset < nativeCount; innerOffset += onceTask_) {
+                int32_t innerCount =
+                    min(static_cast<int32_t>(onceTask_), static_cast<int32_t>(nativeCount - innerOffset));
+                ComputeGradX1(taskOffset + tileOffset + innerOffset, innerCount, innerOffset);
+            }
+        }
+        GetTPipePtr()->ReleaseEventID<HardEvent::V_MTE3>(eventIdVToMTE3XCast);
+    }
+}
