+#include <sstream>
+
+#include "host/utils/hpshmem_log.h"
+#include "../shmemi_logger.h"
+
+extern "C" ACLSHMEM_HOST_API int32_t hpshmem_log(int32_t level, const char *message)
+{
+    if (message == nullptr || level < aclshmem_log::DEBUG_LEVEL || level >= aclshmem_log::BUTT_LEVEL) {
+        return ACLSHMEM_INVALID_VALUE;
+    }
+
+    try {
+        std::ostringstream stream;
+        stream << message;
+        aclshmem_log::aclshmem_out_logger::Instance().write_to_builtin_sink(level, stream);
+        return ACLSHMEM_SUCCESS;
+    } catch (...) {
+        return ACLSHMEM_INNER_ERROR;
+    }
+}
