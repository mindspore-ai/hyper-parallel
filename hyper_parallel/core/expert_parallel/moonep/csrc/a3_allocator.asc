#include <torch/extension.h>
#include "kernel_operator.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"

using namespace AscendC;

static inline int64_t aligned(int64_t n) { return (n + 7) / 8 * 8; }
__aicore__ inline int64_t device_aligned(int64_t n) { return (n + 7) / 8 * 8; }
// Large plans retain their tables in GM and cache bounded pages in UB.
// All accesses belong to one AIV, so a page is flushed before it is reused.
constexpr int32_t kPlannerMaxPage = 1024;
template <bool Paged>
class PlannerArray {
public:
    __aicore__ inline void Init(LocalTensor<int32_t> local, GM_ADDR address,
                               int32_t size, bool resident, int32_t page_size) {
        local_ = local; size_ = size; resident_ = resident; page_size_ = page_size;
        global_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(address));
    }
    __aicore__ inline int32_t GetValue(int32_t index) {
        if (!Paged || resident_) return local_.GetValue(index);
        Select(index);
        return local_.GetValue(index - page_);
    }
    __aicore__ inline void SetValue(int32_t index, int32_t value) {
        if (!Paged || resident_) { local_.SetValue(index, value); return; }
        Select(index);
        local_.SetValue(index - page_, value); dirty_ = true;
    }
    __aicore__ inline void Flush() {
        if (!dirty_) return;
        SetFlag<HardEvent::S_MTE3>(0); WaitFlag<HardEvent::S_MTE3>(0);
        DataCopyExtParams copy{1, static_cast<uint32_t>(PageLength() * 4), 0, 0, 0};
        DataCopyPad(global_[page_], local_, copy);
        SetFlag<HardEvent::MTE3_S>(0); WaitFlag<HardEvent::MTE3_S>(0);
        dirty_ = false;
    }
    __aicore__ inline void Load(GM_ADDR input) {
        GlobalTensor<int32_t> source;
        source.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(input));
        const int32_t step = (!Paged || resident_) ? size_ : page_size_;
        for (int32_t i = 0; i < size_; i += step) {
            int32_t n = size_ - i < step ? size_ - i : step;
            DataCopyExtParams copy{1, static_cast<uint32_t>(n * 4), 0, 0, 0};
            DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
            DataCopyPad(local_, source[i], copy, pad);
            SetFlag<HardEvent::MTE2_S>(0); WaitFlag<HardEvent::MTE2_S>(0);
            if (Paged && !resident_) { page_ = i; dirty_ = true; Flush(); }
        }
    }
    __aicore__ inline void Store(GM_ADDR output) {
        GlobalTensor<int32_t> target;
        target.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(output));
        const int32_t step = (!Paged || resident_) ? size_ : page_size_;
        for (int32_t i = 0; i < size_; i += step) {
            if (Paged && !resident_) Select(i);
            int32_t n = size_ - i < step ? size_ - i : step;
            SetFlag<HardEvent::S_MTE3>(0); WaitFlag<HardEvent::S_MTE3>(0);
            DataCopyExtParams copy{1, static_cast<uint32_t>(n * 4), 0, 0, 0};
            DataCopyPad(target[i], local_, copy);
            SetFlag<HardEvent::MTE3_S>(0); WaitFlag<HardEvent::MTE3_S>(0);
        }
    }
private:
    __aicore__ inline int32_t PageLength() {
        return size_ - page_ < page_size_ ? size_ - page_ : page_size_;
    }
    __aicore__ inline void Select(int32_t index) {
        int32_t page = index / page_size_ * page_size_;
        if (page == page_) return;
        Flush(); page_ = page;
        DataCopyExtParams copy{1, static_cast<uint32_t>(PageLength() * 4), 0, 0, 0};
        DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
        DataCopyPad(local_, global_[page_], copy, pad);
        SetFlag<HardEvent::MTE2_S>(0); WaitFlag<HardEvent::MTE2_S>(0);
    }
    LocalTensor<int32_t> local_;
    GlobalTensor<int32_t> global_;
    int32_t size_ = 0, page_ = -1, page_size_ = 0;
    bool resident_ = false, dirty_ = false;
};

template <bool Paged>
__global__ __aicore__ void allocate_routes(
    GM_ADDR input, GM_ADDR cumulative_out, GM_ADDR offsets_out,
    GM_ADDR boundaries_out, GM_ADDR copies_out, int32_t E, int32_t R,
    int32_t capacity, int32_t bytes, GM_ADDR workspace, uint32_t resident_mask, int32_t page_size) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const int32_t B = E / R;
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, bytes);
    auto all = buffer.Get<int32_t>();
    int32_t pos = 0;
    int64_t global_pos = 0;
    PlannerArray<Paged> counts;
    counts.Init(all[pos], workspace + global_pos * 4, R * E, resident_mask & (1U << 0), page_size);
    pos += (resident_mask & (1U << 0)) ? device_aligned(R * E) : page_size;
    global_pos += device_aligned(R * E);
    PlannerArray<Paged> totals;
    totals.Init(all[pos], workspace + global_pos * 4, E, resident_mask & (1U << 1), page_size);
    pos += (resident_mask & (1U << 1)) ? device_aligned(E) : page_size;
    global_pos += device_aligned(E);
    PlannerArray<Paged> balance;
    balance.Init(all[pos], workspace + global_pos * 4, R, resident_mask & (1U << 2), page_size);
    pos += (resident_mask & (1U << 2)) ? device_aligned(R) : page_size;
    global_pos += device_aligned(R);
    PlannerArray<Paged> transfers;
    transfers.Init(all[pos], workspace + global_pos * 4, R * R, resident_mask & (1U << 3), page_size);
    pos += (resident_mask & (1U << 3)) ? device_aligned(R * R) : page_size;
    global_pos += device_aligned(R * R);
    PlannerArray<Paged> allocation;
    allocation.Init(all[pos], workspace + global_pos * 4, R * E, resident_mask & (1U << 4), page_size);
    pos += (resident_mask & (1U << 4)) ? device_aligned(R * E) : page_size;
    global_pos += device_aligned(R * E);
    PlannerArray<Paged> remaining;
    remaining.Init(all[pos], workspace + global_pos * 4, E, resident_mask & (1U << 5), page_size);
    pos += (resident_mask & (1U << 5)) ? device_aligned(E) : page_size;
    global_pos += device_aligned(E);
    PlannerArray<Paged> quota;
    quota.Init(all[pos], workspace + global_pos * 4, R, resident_mask & (1U << 6), page_size);
    pos += (resident_mask & (1U << 6)) ? device_aligned(R) : page_size;
    global_pos += device_aligned(R);
    PlannerArray<Paged> offsets;
    offsets.Init(all[pos], workspace + global_pos * 4, R * E, resident_mask & (1U << 7), page_size);
    pos += (resident_mask & (1U << 7)) ? device_aligned(R * E) : page_size;
    global_pos += device_aligned(R * E);
    PlannerArray<Paged> cumulative;
    cumulative.Init(all[pos], workspace + global_pos * 4, R * E, resident_mask & (1U << 8), page_size);
    pos += (resident_mask & (1U << 8)) ? device_aligned(R * E) : page_size;
    global_pos += device_aligned(R * E);
    PlannerArray<Paged> boundaries;
    boundaries.Init(all[pos], workspace + global_pos * 4, R * (E + B), resident_mask & (1U << 9), page_size);
    pos += (resident_mask & (1U << 9)) ? device_aligned(R * (E + B)) : page_size;
    global_pos += device_aligned(R * (E + B));
    PlannerArray<Paged> copies;
    copies.Init(all[pos], workspace + global_pos * 4, R * B, resident_mask & (1U << 10), page_size);
    pos += (resident_mask & (1U << 10)) ? device_aligned(R * B) : page_size;
    global_pos += device_aligned(R * B);
    PlannerArray<Paged> selected;
    selected.Init(all[pos], workspace + global_pos * 4, E, resident_mask & (1U << 11), page_size);
    pos += (resident_mask & (1U << 11)) ? device_aligned(E) : page_size;
    global_pos += device_aligned(E);
    counts.Load(input);
    for (int i = 0; i < R * R; ++i) transfers.SetValue(i, 0);
    for (int i = 0; i < R * E; ++i) {
        allocation.SetValue(i, 0); offsets.SetValue(i, 0);
    }
    for (int e = 0; e < E; ++e) totals.SetValue(e, 0);
    // Traverse source rows contiguously when the histogram is paged.
    for (int rank = 0; rank < R; ++rank)
        for (int e = 0; e < E; ++e)
            totals.SetValue(e, totals.GetValue(e) + counts.GetValue(rank * E + e));
    for (int e = 0; e < E; ++e) allocation.SetValue((e / B) * E + e, totals.GetValue(e));
    for (int rank = 0; rank < R; ++rank) {
        int value = -capacity;
        for (int e = rank * B; e < (rank + 1) * B; ++e) value += totals.GetValue(e);
        balance.SetValue(rank, value);
    }
    for (int iteration = 0; iteration < R * 2; ++iteration) {
        int high = 0, low = 0;
        for (int rank = 1; rank < R; ++rank) {
            if (balance.GetValue(rank) > balance.GetValue(high)) high = rank;
            if (balance.GetValue(rank) < balance.GetValue(low)) low = rank;
        }
        if (balance.GetValue(high) <= 0) break;
        const int move = -balance.GetValue(low);
        transfers.SetValue(high * R + low, move);
        balance.SetValue(high, balance.GetValue(high) - move);
        balance.SetValue(low, 0);
    }
    for (int home = 0; home < R; ++home) {
        for (int local = 0; local < B; ++local) remaining.SetValue(local, totals.GetValue(home * B + local));
        for (int dest = 0; dest < R; ++dest) quota.SetValue(dest, transfers.GetValue(home * R + dest));
        for (int iteration = 0; iteration < B + R; ++iteration) {
            int dest = 0, local = 0;
            for (int rank = 1; rank < R; ++rank) if (quota.GetValue(rank) > quota.GetValue(dest)) dest = rank;
            if (quota.GetValue(dest) <= 0) break;
            for (int e = 1; e < B; ++e) if (remaining.GetValue(e) > remaining.GetValue(local)) local = e;
            const int expert = home * B + local;
            const int rem = remaining.GetValue(local), requested = quota.GetValue(dest);
            const int take = rem < requested ? rem : requested;
            allocation.SetValue(dest * E + expert, allocation.GetValue(dest * E + expert) + take);
            allocation.SetValue(home * E + expert, allocation.GetValue(home * E + expert) - take);
            remaining.SetValue(local, rem - take); quota.SetValue(dest, requested - take);
        }
    }
    for (int dest = 0; dest < R; ++dest) {
        for (int e = 0; e < E; ++e) selected.SetValue(e, 0);
        for (int slot = 0; slot < B; ++slot) copies.SetValue(dest * B + slot, -1);
        for (int slot = 0; slot < B; ++slot) {
            int expert = -1, largest = 0;
            for (int e = 0; e < E; ++e) {
                const int count = allocation.GetValue(dest * E + e);
                if (e / B != dest && selected.GetValue(e) == 0 && count > 0 && count >= largest) {
                    largest = count; expert = e;
                }
            }
            if (expert < 0) break;
            copies.SetValue(dest * B + slot, expert);
            if (expert >= 0) selected.SetValue(expert, 1);
        }
        int end = 0;
        for (int group = 0; group < E + B; ++group) {
            int expert = group;
            int count = 0;
            if (group < E) {
                if (selected.GetValue(group) == 0) count = allocation.GetValue(dest * E + group);
            } else {
                expert = copies.GetValue(dest * B + group - E);
                if (expert >= 0) count = allocation.GetValue(dest * E + expert);
            }
            if (count > 0) offsets.SetValue(dest * E + expert, end);
            end += count;
            boundaries.SetValue(dest * (E + B) + group, end);
        }
    }
    if (!Paged || (resident_mask & (1U << 4))) {
        for (int e = 0; e < E; ++e) {
            int total = 0;
            for (int dest = 0; dest < R; ++dest) {
                total += allocation.GetValue(dest * E + e);
                cumulative.SetValue(e * R + dest, total);
            }
        }
        cumulative.Store(cumulative_out);
    } else {
        // Stream rows; a native scan avoids strided page misses for large tables.
        allocation.Store(cumulative_out);
    }
    offsets.Store(offsets_out);
    boundaries.Store(boundaries_out);
    copies.Store(copies_out);
}

std::vector<torch::Tensor> allocate(torch::Tensor counts, int64_t capacity, int64_t ub_bytes) {
    TORCH_CHECK(counts.dim() == 2 && counts.scalar_type() == at::kInt && counts.is_contiguous(), "counts must be contiguous int32 [R,E]");
    int64_t R = counts.size(0), E = counts.size(1);
    TORCH_CHECK(R > 0 && E > 0 && E % R == 0 && capacity > 0, "invalid EP geometry");
    int64_t B = E / R;
    int64_t elements = 4 * aligned(R*E) + 3 * aligned(E) + 2 * aligned(R) + aligned(R*R) + aligned(R*(E+B)) + aligned(R*B);
    const int64_t budget = ub_bytes * 3 / 4 / 4;
    const int64_t sizes[] = {R*E, E, R, R*R, R*E, E, R, R*E, R*E, R*(E+B), R*B, E};
    uint32_t resident_mask = 0;
    const int64_t page_size = std::min<int64_t>(kPlannerMaxPage, budget / 12 / 8 * 8);
    TORCH_CHECK(page_size >= 8, "UB is too small for planner pages");
    int64_t local_elements = 12 * page_size;
    for (int i = 0; i < 12; ++i) {
        if (aligned(sizes[i]) <= page_size) {
            resident_mask |= 1U << i;
            local_elements += aligned(sizes[i]) - page_size;
        }
    }
    // Keep frequently revisited allocation and transfer tables resident first.
    const int order[] = {4, 3, 1, 2, 5, 6, 11, 10, 0, 7, 8, 9};
    for (int i : order) {
        if (resident_mask & (1U << i)) continue;
        int64_t extra = aligned(sizes[i]) - page_size;
        if (local_elements + extra <= budget) {
            resident_mask |= 1U << i;
            local_elements += extra;
        }
    }
    auto workspace = torch::empty({elements}, counts.options());
    auto cumulative = torch::empty({E,R}, counts.options());
    auto offsets = torch::empty({R,E}, counts.options());
    auto boundaries = torch::empty({R,E+B}, counts.options());
    auto copies = torch::empty({R,B}, counts.options());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto run = [=]() -> int {
        if (resident_mask == (1U << 12) - 1) {
            allocate_routes<false><<<1, nullptr, stream>>>(
                (GM_ADDR)counts.data_ptr(), (GM_ADDR)cumulative.data_ptr(),
                (GM_ADDR)offsets.data_ptr(), (GM_ADDR)boundaries.data_ptr(), (GM_ADDR)copies.data_ptr(),
                E, R, capacity, local_elements * 4, (GM_ADDR)workspace.data_ptr(), resident_mask, page_size);
        } else {
            allocate_routes<true><<<1, nullptr, stream>>>(
                (GM_ADDR)counts.data_ptr(), (GM_ADDR)cumulative.data_ptr(),
                (GM_ADDR)offsets.data_ptr(), (GM_ADDR)boundaries.data_ptr(), (GM_ADDR)copies.data_ptr(),
                E, R, capacity, local_elements * 4, (GM_ADDR)workspace.data_ptr(), resident_mask, page_size);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MoonEPA3Allocate",run);
    if (!(resident_mask & (1U << 4)))
        cumulative = cumulative.view({R, E}).cumsum(0, at::kInt).t().contiguous();
    return {cumulative, offsets, boundaries, copies};
}
#include "routing_kernels.h"

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("allocate", &allocate);
    m.def("render", &routing_kernels::render);
}
