+def resolve_causal_conv_activation(module) -> tuple[int, bool]:
+    mode = getattr(
+        module,
+        "causal_conv_activation_mode",
+        CAUSAL_CONV_ACTIVATION_MODE_FUSED,
+    )
+    if mode not in SUPPORTED_CAUSAL_CONV_ACTIVATION_MODES:
+        raise ValueError(
+            f"Unsupported causal_conv_activation_mode={mode!r}; "
+            f"expected one of {sorted(SUPPORTED_CAUSAL_CONV_ACTIVATION_MODES)}"
+        )
+    if not module.activation:
+        return 0, False
+    if mode == CAUSAL_CONV_ACTIVATION_MODE_SEPARATE_BF16:
+        if module.activation not in ("silu", "swish"):
+            raise ValueError(
+                f"separate_bf16 supports only SiLU activation, got {module.activation!r}"
+            )
+        return 0, True
+    return 1, False
+
+
+def apply_separate_causal_conv_activation(
+    output: torch.Tensor,
+    separate_activation: bool,
+) -> torch.Tensor:
+    return F.silu(output) if separate_activation else output
+
+
+def compute_gdn_gating(
