+            f"expected one of {sorted(SUPPORTED_GDN_GATING_MODES)}"
+        )
+    if mode == GDN_GATING_MODE_TORCH:
+        beta = b.sigmoid()
+        g = -module.A_log.float().exp() * F.softplus(a.float() + module.dt_bias)
+        if g.ndim == 2:
+            g = g.unsqueeze(0)
+            beta = beta.unsqueeze(0)
+        return g, beta
+    return DeviceOperator.fused_gdn_gating(module.A_log, a, b, module.dt_bias)
+
+
+def resolve_gdn_recurrence_mode(module) -> str:
