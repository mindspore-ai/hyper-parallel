ARG BASE_IMAGE=hyper-parallel/hyper-rl:v0.22.1rc1
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG DEEPSEEK_HARNESS_VERSION=0.1.1rc1

RUN set -eux; \
    PIP_DISABLE_PIP_VERSION_CHECK=1 python -m pip install --no-cache-dir \
        "deepseek-harness-sdk==${DEEPSEEK_HARNESS_VERSION}"

RUN python -c "from importlib.metadata import version; \
expected = {'deepseek-harness-sdk': '${DEEPSEEK_HARNESS_VERSION}', \
'flash-attn-npu': '0.2.0b1'}; actual = {name: version(name) for name in expected}; \
assert actual == expected, f'dependency version mismatch: expected={expected}, actual={actual}'; \
import deepseek_harness; print(actual)"

LABEL org.opencontainers.image.title="Hyper-RL DeepSeek Harness runtime" \
      org.opencontainers.image.description="DeepSeek Harness runtime for Hyper-RL on Ascend" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      hyper-rl.deepseek-harness-sdk.version="0.1.1rc1"
