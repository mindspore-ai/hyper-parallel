ARG AGENT_IMAGE=swr.cn-east-3.myhuaweicloud.com/huawei-hyper-rl/hyper-rl@sha256:0d1e8af0cbc8eb558497958b827260fa6d9a635fc20e4ec74916587b0348731d
ARG BASE_IMAGE=python:3.12.13-slim-bookworm@sha256:3f9c7f75b916e8279e24136d7a57769aba9e193715be52570417698c52d6eed0
FROM ${AGENT_IMAGE} AS agent
FROM ${BASE_IMAGE}

ARG DEBIAN_MIRROR=https://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends bash ca-certificates git procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=agent /opt/codex /opt/codex
ENV PATH=/opt/codex/bin:/opt/codex/codex-path:${PATH} SHELL=/bin/bash
RUN printf '%s\n' \
    '285958769bc41cd70812524ca96631bf679635f4f1c08320ab1f31d958e81b24  /opt/codex/bin/codex' \
    '8c5723b7c2c642bb07d94166ee8effa11dc3b78166a29209df1b1983d0a5b3e9  /opt/codex/bin/codex-code-mode-host' \
    | sha256sum --check \
    && test "$(codex --version)" = 'codex-cli 0.152.1' \
    && python3 -c 'import shutil; assert all(shutil.which(x) for x in ("bash", "rg", "sed", "cat", "git"))'
# Candidates have a read-only root; compile stdlib once instead of on every Python startup.
RUN python3 -m compileall -q -x '/site-packages/' /usr/local/lib/python3.12
WORKDIR /work
