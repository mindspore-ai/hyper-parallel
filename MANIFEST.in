include requirements.txt
include README.md
include README.en.md
include LICENSE
include scripts/hyper_parallel_multicore_set_env.bash
prune build
prune dist
prune *.egg-info
prune .git
prune __pycache__
prune .pytest_cache
prune .mypy_cache
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude *.pyd
global-exclude *.dylib
global-exclude *.dll
global-exclude .git*
global-exclude .gitignore
global-exclude .commit_id
