include requirements.txt
include README.md
include README.en.md
include LICENSE
include build.sh
include hyper_parallel/data/indexed/csrc/Makefile
include hyper_parallel/platform/torch/custom_ops/kda/README.md
recursive-include scripts *.py *.sh *.json
recursive-include hyper_parallel *.sh *.bash *.cpp *.cc *.h *.hpp *.cmake CMakeLists.txt *.patch *.json *.yaml *.ini *.md *.txt
prune build
prune dist
prune *.egg-info
prune .git
prune __pycache__
prune .pytest_cache
prune .mypy_cache
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude *.pyd
global-exclude *.dylib
global-exclude *.dll
global-exclude .git*
global-exclude .gitignore
global-exclude .commit_id
