# These legacy PTA tags omit the CANN version.
ARG LEGACY_CANN=9.0.0
ARG BASE_A2_UBUNTU_PY311=swr.cn-south-1.myhuaweicloud.com/ascendhub/torch-npu:2.9.0.post2-910b-ubuntu22.04-py3.11@sha256:55a05ca73fe687d6353e7b1e2a6a5a1dae43b026396cc51361d4e8a9ebdc3b85
ARG BASE_A2_OPENEULER_PY311=swr.cn-south-1.myhuaweicloud.com/ascendhub/torch-npu:2.9.0.post2-910b-openeuler24.03-py3.11@sha256:c9227679bf9720fd550b0cf7cd56725e13802e0232d0e92a57d3c2d1e20aea04
ARG BASE_A3_UBUNTU_PY311=swr.cn-south-1.myhuaweicloud.com/ascendhub/torch-npu:2.9.0.post2-a3-ubuntu22.04-py3.11@sha256:a23f119392fc3b38e253ab4ead306c809b5b1d9527747d50be2f0c39abf05aca
ARG BASE_A3_OPENEULER_PY311=swr.cn-south-1.myhuaweicloud.com/ascendhub/torch-npu:2.9.0.post2-a3-openeuler24.03-py3.11@sha256:c9a4bf1ea1bda60e0e2e77b4825602b70ad0d06b806d7aeea79fdb594b801550
ARG BASE_IMAGE=${BASE_A2_UBUNTU}
ARG HP_VERSION=1.2.0.dev0
ARG DEFAULT_HYPER_PARALLEL_COMMIT=c84594c4578c4ad7b048db40fa0c4998c776c0e4
# Accept source selectors from earlier versions of this recipe.
ARG HP_REVISION
ARG HP_BRANCH
ARG HYPER_PARALLEL_COMMIT=${HP_REVISION}
ARG HYPER_PARALLEL_BRANCH=${HP_BRANCH}
# A direct branch build records its resolved SHA in the image at build time.
ARG HP_BRANCH_STAGE=${HYPER_PARALLEL_BRANCH:+hp-branch}
ARG HP_FINAL_STAGE=${HP_BRANCH_STAGE:-hp-commit}
ARG PYTHON_VERSION
ARG CANN_VERSION
ARG TORCH_VERSION
ARG TORCH_NPU_VERSION

FROM ${BASE_IMAGE} AS runtime
ARG PYTHON_VERSION
ARG CANN_VERSION
RUN actual=$(python3 -I -c 'import sys; print("%d.%d" % sys.version_info[:2])') \
    && case "$actual" in 3.10|3.11|3.12) ;; *) echo "Unsupported base Python: $actual" >&2; exit 1 ;; esac \
    && test "${PYTHON_VERSION:-$actual}" = "$actual" \
    && if [ -n "$CANN_VERSION" ]; then \
        test -d "/usr/local/Ascend/cann-$CANN_VERSION" || test -d "/usr/local/Ascend/ascend-toolkit/$CANN_VERSION" \
            || { echo "Base does not provide CANN $CANN_VERSION" >&2; exit 1; }; fi

FROM runtime AS wheel
WORKDIR /build
RUN if ! command -v git >/dev/null || ! command -v g++ >/dev/null || ! command -v make >/dev/null; then \
        if command -v apt-get >/dev/null; then apt-get update && apt-get install -y --no-install-recommends git g++ make ca-certificates; \
        else dnf install -y git gcc-c++ make ca-certificates; fi; \
    fi
COPY build.sh /tmp/hp-image-build.sh
ARG DEFAULT_HYPER_PARALLEL_COMMIT
ARG HYPER_PARALLEL_COMMIT
ARG HYPER_PARALLEL_BRANCH
RUN bash /tmp/hp-image-build.sh _checkout-source \
    && python3 -m pip install --no-cache-dir --index-url https://pypi.org/simple \
        setuptools==80.9.0 wheel==0.45.1 pybind11==3.0.1 \
    && bash /tmp/hp-image-build.sh _build-wheel

FROM runtime AS app
ARG HP_VERSION
ARG TORCH_VERSION
ARG TORCH_NPU_VERSION
COPY --from=wheel /build/dist/*.whl /tmp/hp-wheel/
COPY --from=wheel /tmp/hyper-parallel-revision /etc/hyper-parallel-revision
COPY build.sh /tmp/hp-build.sh
RUN bash /tmp/hp-build.sh _install-runtime && rm -r /tmp/hp-wheel /tmp/hp-build.sh

LABEL org.opencontainers.image.title="HyperParallel" \
      org.opencontainers.image.description="Distributed PyTorch workloads on Ascend" \
      org.opencontainers.image.version="${HP_VERSION}" \
      org.opencontainers.image.source="https://github.com/mindspore-ai/hyper-parallel" \
      org.opencontainers.image.documentation="https://github.com/mindspore-ai/hyper-parallel/tree/master/docker"

# Print the notice once and let the inherited AscendHub entrypoint initialize the selected product.
RUN printf '%s\n' "HyperParallel $(python3 -I -c 'from importlib.metadata import version; print(version("hyper-parallel"))')" \
        'Container image Copyright (c) 2026, Huawei Technologies Co., Ltd. All rights reserved.' \
        'This container image and its contents are governed by the Huawei Container License Agreement ("License").' \
        'By pulling and using the container, you accept the terms and conditions of this License.' \
        'A copy of this License is made available in this container at: https://www.hiascend.com/en/legal/ascendhub-download' \
        'Note: You agree and undertake that when using Huawei or third-party software in this image, you will comply with the license agreement of the corresponding Huawei or third-party software.' \
        > /etc/hyper-parallel-image \
    && printf '%s\n' 'unset BASH_ENV' 'cat /etc/hyper-parallel-image >&2' > /etc/hyper-parallel-startup.sh
ENV BASH_ENV=/etc/hyper-parallel-startup.sh
WORKDIR /workspace
CMD ["/bin/bash"]

# Labels cannot read a RUN result. Only expose a revision label when it is an immutable build input.
FROM app AS hp-branch
ARG HYPER_PARALLEL_BRANCH
LABEL org.opencontainers.image.ref.name="${HYPER_PARALLEL_BRANCH}" org.opencontainers.image.revision=""

FROM app AS hp-commit
ARG DEFAULT_HYPER_PARALLEL_COMMIT
ARG HYPER_PARALLEL_COMMIT
LABEL org.opencontainers.image.revision="${HYPER_PARALLEL_COMMIT:-$DEFAULT_HYPER_PARALLEL_COMMIT}"

FROM ${HP_FINAL_STAGE}
