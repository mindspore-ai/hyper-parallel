#!/bin/bash
# Git commit-msg hook: reject commit messages containing AI/IDE attribution trailers
# (e.g. Made-with: Cursor). Install: cp .claude/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
#
# This hook runs for all git commits (including Cursor UI, manual git commit).
# autogit commit also validates via commit_msg_check.py before calling git.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CHECK_SCRIPT="${REPO_ROOT}/.claude/skills/autogit/scripts/commit_msg_check.py"

if [ -z "$1" ]; then
  echo "commit-msg hook: no message file path" >&2
  exit 1
fi

if [ ! -f "$CHECK_SCRIPT" ]; then
  exit 0
fi

python3 "$CHECK_SCRIPT" "$1"
exit $?
